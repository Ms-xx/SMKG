# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
_cov_*.txt
.python-version

# ── 环境变量 / 密钥（.env 一律不进库）───────────────────
.env
.env.*
!.env.example
!.env.development
!.env.production

# ── 集中化配置目录：仅提交 *.example 模板，真实值不进库 ──
# 真实文件：config/common.env、config/backend.env、config/graphrag.env
config/*.env
!config/*.env.example

# ── 前端 / Node ─────────────────────────────────────────
node_modules/
dist/
build/
.pnpm-store/
.vite/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
*.tsbuildinfo
*.local

# ── 模型与大数据文件（moulds/ 约 3.7GB，不进 git）───────
moulds/
/models/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
*.ckpt

# ── 生成产物 / 上传输出 / 日志 ──────────────────────────
outputs/
usingtest/
timeout/
*.log
*.out

# ── 运行时上传存储（MinIO 本地降级落盘）─ 不进库 ──────────
backend/storage/

# ── 本地文档/示例数据（按用户要求不推送远端）──────────────
others/
database/

# ── 外采数据集（本地使用，不进库）──────────────────────────
download_data/

# ── 数据库文件 ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── MLflow 本地 tracking server 运行时存储（步骤 14.3，不进库）──
# 独立存储目录：backend store(sqldb) / artifacts / logs；仓库内 `deploy/mlflow/` 脚本仍进库
/mlflow/

# ── GraphRAGTest：本地密钥与示例 PDF 文档 ──────────────
GraphRAGTest/.env
GraphRAGTest/__pycache__/
GraphRAGTest/*.pdf

# ── Celery beat 调度状态（运行产物，不进库）─────────────
celerybeat-schedule*

