# Application
APP_NAME=Scientific Document Parser
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://root:20020522@localhost:3306/wx
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=wang245484@

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Models
# 模型统一存放于项目根 moulds/ 下，EMBEDDING_MODEL_PATH / LLM_MODEL_PATH 由 config.py 默认解析为 moulds/bge-m3、moulds/qwen-7b（勿覆盖为 ./models）
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_DEVICE=cpu

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=pdf

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
