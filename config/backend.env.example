# 后端配置（模板，复制为 backend.env 后填入真实值）

ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".pdf"]
API_PREFIX=/api/v1
APP_NAME=Scientific Document Parser
APP_VERSION=1.0.0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_SIZE=20
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@127.0.0.1:3306/wx
DEBUG=true
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_KEY=CHANGE_ME
LLM_DEVICE=cpu
LLM_ENABLED=True
LLM_ENDPOINT=http://127.0.0.1:1234/v1
LLM_MAX_TOKENS=4096
LLM_MODEL=qwen/qwen3-4b-2507
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=104857600
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_BUCKET_NAME=documents
MINIO_ENDPOINT=localhost:9000
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
REDIS_URL=redis://localhost:6379/0
TRANSLATION_ENABLED=True
TRANSLATION_ENDPOINT=http://127.0.0.1:1234/v1
TRANSLATION_MODEL=qwen/qwen3-4b-2507
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
