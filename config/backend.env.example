# 后端配置（模板，复制为 backend.env 后填入真实值）

ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".pdf"]
API_PREFIX=/api/v1
APP_NAME=Scientific Document Parser
APP_VERSION=1.0.0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_SIZE=20
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@127.0.0.1:3306/wx
DEBUG=true
# 部署模式：local = 本地部署（本项目唯一官方支持的适用模式）；cloud = 云上部署（非官方支持，仅代码层扩展预留）
DEPLOY_MODE=local
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_KEY=CHANGE_ME
LLM_DEVICE=cpu
LLM_ENABLED=True
LLM_ENDPOINT=http://127.0.0.1:1234/v1
LLM_MAX_TOKENS=4096
LLM_MODEL=qwen/qwen3-4b-2507
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_LEVEL=INFO
# 监控告警栈（步骤2）：输出 JSON 结构化日志并落盘，供 Filebeat→Logstash→ES→Kibana 采集
LOG_JSON=true
# 绝对路径（请按 <repo>/logs/app.log 实际位置填写；Filebeat 挂载 ./logs 到容器 /var/log/app）
LOG_FILE=CHANGE_ME_PATH_LOGS_APP_LOG
# 告警外发渠道（钉钉/企业微信/通用 webhook）；留空 = 仅本地结构化日志并进入 ELK（无凭据时的降级口径）
ALERT_WEBHOOK_URL=CHANGE_ME
MAX_UPLOAD_SIZE=104857600
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_BUCKET_NAME=documents
MINIO_ENDPOINT=localhost:9000
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
REDIS_URL=redis://localhost:6379/0
TRANSLATION_ENABLED=True
TRANSLATION_ENDPOINT=http://127.0.0.1:1234/v1
TRANSLATION_MODEL=qwen/qwen3-4b-2507
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ── MLflow 本地 tracking server 接入（步骤 14.3，官方本地部署口径）──────────
# 服务端：deploy/mlflow/start_mlflow_server.ps1（独立存储目录 <仓库根>/mlflow，见 deploy/mlflow/README.md）
# 启用步骤：MLFLOW_ENABLED=true 且 VERSION_MGMT_BACKEND=dvc_mlflow
# 所有 MLflow 追踪请求统一指向下方本地地址；服务端不可达时自动降级内置注册表（builtin）
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_STORE_DIR 留空即用默认值 <仓库根>/mlflow（勿硬编码绝对路径）
MLFLOW_EXPERIMENT_NAME=sdp-version-management
MLFLOW_TRACKING_TIMEOUT=5
VERSION_MGMT_BACKEND=builtin
